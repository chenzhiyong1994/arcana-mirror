.mode-list { margin-top: 44rpx; }
.mode { padding: 26rpx 0; border-bottom: 1rpx solid rgba(168, 137, 80, 0.25); }
.mode.selected { color: var(--gold); }
.mode-head { display: flex; justify-content: space-between; font-size: 31rpx; }
.indicator { color: var(--gold); }
.mode-desc { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.section-title { font-size: 32rpx; }
.data-panel, .about-panel { margin-top: 48rpx; }
.data-panel .muted, .about-panel .muted { margin-top: 16rpx; }
.version { margin-top: 28rpx; color: var(--gold); font-size: 22rpx; letter-spacing: 3rpx; }
