.settings-page { padding-top: 44rpx; }
.settings-page .title { font-size: 64rpx; }
.ai-panel { position: relative; margin-top: 58rpx; padding: 34rpx 30rpx; overflow: hidden; border: 1rpx solid rgba(184,150,87,.32); background: linear-gradient(135deg, rgba(184,150,87,.08), rgba(244,234,215,.02)); }
.ai-panel .muted { margin-top: 14rpx; }
.data-panel { position: relative; margin-top: 62rpx; padding: 34rpx 30rpx; overflow: hidden; border: 1rpx solid rgba(184,150,87,.32); background: rgba(244,234,215,.025); }
.panel-icon { position: absolute; top: 25rpx; right: 28rpx; color: rgba(184,150,87,.5); font-size: 28rpx; }
.data-panel .muted { margin-top: 14rpx; }
.data-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(184,150,87,.18); }
.data-name { color: var(--paper-dim); font-size: 27rpx; }
.data-note { margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }
.danger-link { width: auto; min-height: 56rpx; padding: 6rpx 15rpx; border: 1rpx solid rgba(168,91,79,.45); background: transparent; color: #c48176; font-size: 20rpx; line-height: 42rpx; }
.about-panel { display: flex; align-items: center; margin-top: 52rpx; padding-top: 34rpx; border-top: 1rpx solid rgba(184,150,87,.2); }
.about-logo { flex: 0 0 112rpx; width: 112rpx; height: 112rpx; border: 1rpx solid rgba(184,150,87,.4); border-radius: 50%; }
.about-copy { margin-left: 25rpx; }
.about-copy .section-title { margin-top: 0; font-size: 31rpx; }
.about-copy .muted { margin-top: 8rpx; font-size: 21rpx; line-height: 1.55; }
.version { margin-top: 13rpx; color: var(--gold); font-family: Georgia, serif; font-size: 15rpx; letter-spacing: 3rpx; }
