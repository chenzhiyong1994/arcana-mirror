.progress-panel { display: flex; align-items: center; justify-content: space-between; margin-top: 40rpx; padding: 28rpx; border: 1rpx solid rgba(168, 137, 80, 0.5); background: rgba(168, 137, 80, 0.06); }
.progress-number { color: var(--gold); font-size: 44rpx; }
.percent { color: var(--paper-dim); font-size: 36rpx; }
.collection-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28rpx 16rpx; margin-top: 42rpx; }
.collection-card { min-width: 0; text-align: center; }
.collection-card.locked { opacity: 0.48; }
.image-shell { position: relative; overflow: hidden; border: 1rpx solid rgba(168, 137, 80, 0.55); background: #171511; aspect-ratio: 2 / 3; }
.card-image { width: 100%; height: 100%; }
.lock-mark { position: absolute; top: 50%; left: 50%; color: var(--paper-dim); font-size: 54rpx; transform: translate(-50%, -50%); text-shadow: 0 4rpx 12rpx #000; }
.card-index { margin-top: 12rpx; color: var(--gold); font-size: 20rpx; }
.card-name { margin-top: 4rpx; overflow: hidden; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-mask { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.78); }
.detail-panel { position: relative; width: 100%; max-height: 88vh; box-sizing: border-box; overflow-y: auto; padding: 34rpx 34rpx 64rpx; border-top: 1rpx solid var(--gold); background: #15130f; }
.close { position: absolute; z-index: 2; top: 18rpx; right: 22rpx; width: 64rpx; height: 64rpx; padding: 0; background: rgba(17, 16, 14, 0.86); color: var(--gold); font-size: 44rpx; line-height: 64rpx; }
.detail-image { display: block; width: 300rpx; height: 450rpx; margin: 0 auto; }
.detail-title { margin-top: 24rpx; font-size: 40rpx; text-align: center; }
.detail-en { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; letter-spacing: 2rpx; text-align: center; }
.detail-meta { margin-top: 12rpx; color: var(--gold); font-size: 22rpx; text-align: center; }
.detail-section { margin-top: 28rpx; }
.detail-label { color: var(--gold); font-size: 23rpx; letter-spacing: 3rpx; }
.detail-text { margin-top: 10rpx; color: var(--paper-dim); font-size: 28rpx; line-height: 1.65; }
