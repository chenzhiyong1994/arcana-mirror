.collection-page { padding-top: 42rpx; }
.collection-head .title { font-size: 64rpx; }
.progress-panel { display: flex; align-items: center; margin-top: 44rpx; padding: 34rpx 28rpx; border: 1rpx solid rgba(184,150,87,.34); background: linear-gradient(135deg, rgba(184,150,87,.11), rgba(244,234,215,.018)); }
.progress-orbit { display: flex; align-items: center; justify-content: center; flex-direction: column; flex: 0 0 150rpx; height: 150rpx; border: 1rpx solid var(--gold); border-radius: 50%; box-shadow: inset 0 0 0 9rpx #0e0c09, inset 0 0 0 10rpx rgba(184,150,87,.25), 0 0 36rpx rgba(184,150,87,.08); }
.progress-number { color: var(--gold-bright); font-family: Georgia, serif; font-size: 30rpx; }
.progress-label { margin-top: 4rpx; color: var(--muted); font-size: 18rpx; letter-spacing: 2rpx; }
.progress-copy { flex: 1; min-width: 0; margin-left: 28rpx; }
.percent { color: var(--paper); font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.percent text { margin-left: 3rpx; color: var(--gold); font-size: 22rpx; }
.progress-caption { margin-top: 8rpx; color: var(--paper-dim); font-size: 23rpx; }
.progress-track { height: 3rpx; margin-top: 20rpx; background: rgba(184,150,87,.18); }
.progress-fill { height: 100%; background: var(--gold-bright); box-shadow: 0 0 12rpx rgba(224,191,121,.34); transition: width 600ms ease; }
.progress-note { margin-top: 13rpx; color: var(--muted); font-size: 18rpx; line-height: 1.5; }
.collection-rule { display: flex; align-items: center; margin: 46rpx 0 28rpx; color: rgba(184,150,87,.62); font-family: Georgia, serif; font-size: 16rpx; }
.collection-rule view { flex: 1; height: 1rpx; margin: 0 15rpx; background: linear-gradient(90deg, rgba(184,150,87,.15), rgba(184,150,87,.48), rgba(184,150,87,.15)); }
.collection-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34rpx 17rpx; }
.collection-card { min-width: 0; text-align: center; }
.collection-card:active { transform: scale(.975); }
.collection-card.locked { opacity: .56; }
.image-shell { position: relative; overflow: hidden; border: 1rpx solid rgba(184,150,87,.52); border-radius: 5rpx; background: #11100d; aspect-ratio: 2 / 3; box-shadow: 0 12rpx 28rpx rgba(0,0,0,.36); }
.discovered .image-shell { box-shadow: 0 15rpx 34rpx rgba(0,0,0,.45), 0 0 18rpx rgba(184,150,87,.07); }
.card-image { width: 100%; height: 100%; }
.locked-veil { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(4,4,3,.3); }
.lock-sigil { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 1rpx solid rgba(224,191,121,.5); border-radius: 50%; color: var(--gold); font-size: 20rpx; box-shadow: 0 0 18rpx rgba(184,150,87,.12); }
.discovered-shine { position: absolute; top: -20%; left: -60%; width: 28%; height: 140%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); animation: gold-sheen 6.8s ease-in-out infinite; }
.card-index { margin-top: 13rpx; color: var(--gold); font-family: Georgia, serif; font-size: 18rpx; }
.card-name { margin-top: 5rpx; overflow: hidden; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.84); animation: mask-in 260ms ease both; }
.detail-panel { position: relative; width: 100%; max-height: 92vh; box-sizing: border-box; overflow-y: auto; padding: 24rpx 36rpx calc(70rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--gold); border-radius: 26rpx 26rpx 0 0; background: radial-gradient(circle at 50% 0, rgba(184,150,87,.12), transparent 32%), #100e0b; animation: sheet-up 420ms cubic-bezier(.18,.85,.24,1) both; }
.sheet-handle { width: 70rpx; height: 5rpx; margin: 0 auto 22rpx; border-radius: 99rpx; background: rgba(184,150,87,.38); }
.close { position: absolute; z-index: 2; top: 26rpx; right: 28rpx; width: 62rpx; height: 62rpx; padding: 0; border: 1rpx solid rgba(184,150,87,.35); background: rgba(9,9,7,.75); color: var(--gold); font-family: Georgia, serif; font-size: 40rpx; line-height: 58rpx; }
.detail-hero { position: relative; display: flex; justify-content: center; height: 480rpx; }
.detail-halo { position: absolute; top: 70rpx; left: 50%; width: 340rpx; height: 340rpx; border: 1rpx solid rgba(184,150,87,.15); border-radius: 50%; transform: translateX(-50%); box-shadow: 0 0 60rpx rgba(184,150,87,.09); }
.detail-image { position: relative; z-index: 1; display: block; width: 300rpx; height: 450rpx; border: 1rpx solid rgba(224,191,121,.55); border-radius: 5rpx; box-shadow: 0 25rpx 56rpx rgba(0,0,0,.56); }
.detail-index { margin-top: 10rpx; color: var(--gold); font-family: Georgia, serif; font-size: 19rpx; letter-spacing: 4rpx; text-align: center; }
.detail-title { margin-top: 7rpx; font-size: 44rpx; text-align: center; }
.detail-en { margin-top: 7rpx; color: var(--muted); font-family: Georgia, serif; font-size: 18rpx; letter-spacing: 3rpx; text-align: center; text-transform: uppercase; }
.detail-meta { display: flex; justify-content: center; gap: 18rpx; margin-top: 16rpx; color: var(--gold); font-size: 20rpx; }
.detail-meta text + text { padding-left: 18rpx; border-left: 1rpx solid rgba(184,150,87,.3); }
.detail-section { margin-top: 30rpx; padding-top: 25rpx; border-top: 1rpx solid rgba(184,150,87,.18); }
.detail-label { color: var(--gold); font-family: Georgia, "Songti SC", serif; font-size: 19rpx; letter-spacing: 3rpx; }
.detail-text { margin-top: 12rpx; color: var(--paper-dim); font-size: 27rpx; line-height: 1.72; }
.reflection-card { margin-top: 34rpx; padding: 28rpx; border: 1rpx solid rgba(184,150,87,.34); background: rgba(184,150,87,.07); text-align: center; }
.reflection-text { margin-top: 15rpx; color: var(--paper); font-size: 32rpx; line-height: 1.62; }
@keyframes sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
