<view class="page collection-page">
  <view class="collection-head enter-up">
    <view class="eyebrow">THE MAJOR ARCANA</view>
    <view class="title">心镜图鉴</view>
    <view class="subtitle">不是集齐一套答案，而是记录你曾亲手照见的象征。</view>
  </view>

  <view class="progress-panel enter-up delay-1">
    <view class="progress-orbit">
      <view class="progress-number">{{progress}}</view>
      <view class="progress-label">已照见</view>
    </view>
    <view class="progress-copy">
      <view class="percent">{{percent}}<text>%</text></view>
      <view class="progress-caption">大阿尔卡那探索进度</view>
      <view class="progress-track"><view class="progress-fill" style="width: {{percent}}%"></view></view>
      <view class="progress-note">每次翻开都会记录正逆位与相遇次数。</view>
    </view>
  </view>

  <view class="collection-rule"><text>0</text><view></view><text>21</text></view>

  <view class="collection-grid">
    <view wx:for="{{cards}}" wx:key="id" class="collection-card {{item.discovered ? 'discovered' : 'locked'}}" data-id="{{item.id}}" bindtap="openCard">
      <view class="image-shell">
        <image class="card-image" src="{{item.discovered ? item.imagePath : cardBack}}" mode="aspectFill" />
        <view wx:if="{{!item.discovered}}" class="locked-veil"><view class="lock-sigil">◇</view></view>
        <view wx:else class="discovered-shine"></view>
      </view>
      <view class="card-index">{{item.roman}}</view>
      <view class="card-name">{{item.discovered ? item.name : '未照见'}}</view>
    </view>
  </view>

  <view wx:if="{{selected}}" class="detail-mask" bindtap="closeCard">
    <view class="detail-panel" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <button class="close" bindtap="closeCard">×</button>
      <view class="detail-hero">
        <view class="detail-halo"></view>
        <image class="detail-image" src="{{selected.imagePath}}" mode="aspectFit" />
      </view>
      <view class="detail-index">{{selected.roman}}</view>
      <view class="detail-title">{{selected.name}}</view>
      <view class="detail-en">{{selected.englishName}}</view>
      <view class="detail-meta"><text>翻开 {{selected.revealCount}} 次</text><text>{{selected.orientationProgress}}</text></view>
      <view class="ornament-rule">✦</view>
      <view class="detail-section">
        <view class="detail-label">正位 · LIGHT</view>
        <view class="detail-text">{{selected.upright}}</view>
      </view>
      <view class="detail-section">
        <view class="detail-label">逆位 · SHADOW</view>
        <view class="detail-text">{{selected.reversed}}</view>
      </view>
      <view class="reflection-card">
        <view class="detail-label">SELF REFLECTION</view>
        <view class="reflection-text">{{selected.reflection}}</view>
      </view>
    </view>
  </view>
</view>
