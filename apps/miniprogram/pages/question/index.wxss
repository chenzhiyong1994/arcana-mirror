.field-label { margin-top: 44rpx; color: var(--gold); font-size: 24rpx; }
.topic-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 18rpx; }
.topic { min-height: 72rpx; padding: 8rpx; border: 1rpx solid rgba(168, 137, 80, 0.36); background: transparent; color: var(--paper-dim); font-size: 26rpx; line-height: 54rpx; }
.topic.selected { border-color: var(--gold); background: rgba(168, 137, 80, 0.2); color: var(--paper); }
.question-input { width: 100%; height: 240rpx; box-sizing: border-box; margin-top: 18rpx; padding: 24rpx; border: 1rpx solid rgba(168, 137, 80, 0.5); background: rgba(241, 234, 220, 0.04); color: var(--paper); font-size: 30rpx; line-height: 1.55; }
.placeholder { color: #70695f; }
.count { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; text-align: right; }
.decision.blocked { border-color: var(--danger); }
.decision-code { color: var(--gold); font-size: 22rpx; letter-spacing: 2rpx; }
.decision-message, .suggestion { margin-top: 16rpx; color: var(--paper-dim); font-size: 28rpx; line-height: 1.6; }
.suggestion { color: var(--paper); }
.privacy-note { margin-top: 28rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
