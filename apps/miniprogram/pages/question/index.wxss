.question-page { padding-top: 32rpx; }
.flow-head { display: flex; align-items: center; width: 190rpx; margin-left: auto; color: var(--gold); font-family: Georgia, serif; font-size: 19rpx; }
.flow-line { flex: 1; height: 1rpx; margin: 0 12rpx; background: rgba(184,150,87,0.25); }
.flow-line-active { width: 33%; height: 100%; background: var(--gold-bright); }
.question-page .title { margin-top: 24rpx; font-size: 64rpx; }
.question-page .title-line { display: block; }
.question-page .subtitle { margin-top: 20rpx; }
.form-section { margin-top: 58rpx; }
.field-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16rpx; border-bottom: 1rpx solid rgba(184,150,87,0.25); color: var(--paper-dim); font-size: 27rpx; letter-spacing: 2rpx; }
.field-index { color: var(--gold); font-family: Georgia, serif; font-size: 19rpx; }
.spread-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.spread-option { position: relative; min-height: 250rpx; padding: 24rpx; border: 1rpx solid rgba(184,150,87,0.24); border-radius: 6rpx; background: rgba(244,234,215,0.02); transition: transform 160ms ease, border-color 160ms ease; }
.spread-option:active { transform: scale(0.985); }
.spread-option.selected { border-color: rgba(224,191,121,0.78); background: linear-gradient(145deg, rgba(184,150,87,0.14), rgba(244,234,215,0.018)); box-shadow: inset 0 0 0 5rpx #0c0a08, inset 0 0 0 6rpx rgba(184,150,87,0.2); }
.spread-check { position: absolute; top: 18rpx; right: 18rpx; color: var(--gold-bright); font-size: 20rpx; }
.spread-visual { display: flex; align-items: flex-end; height: 72rpx; }
.spread-mini { width: 34rpx; height: 54rpx; border: 1rpx solid rgba(224,191,121,0.72); border-radius: 2rpx; background: #11100d; box-shadow: inset 0 0 0 4rpx #11100d, inset 0 0 0 5rpx rgba(184,150,87,0.3); }
.spread-visual.three .spread-mini { margin-right: -9rpx; transform: rotate(-8deg); }
.spread-visual.three .spread-mini:nth-child(2) { z-index: 2; transform: translateY(-6rpx); }
.spread-visual.three .spread-mini:nth-child(3) { transform: rotate(8deg); }
.spread-name { margin-top: 17rpx; font-size: 31rpx; }
.spread-desc { margin-top: 9rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; }
.question-shell { position: relative; margin-top: 20rpx; padding: 30rpx 24rpx 20rpx; border: 1rpx solid rgba(184,150,87,0.4); border-radius: 6rpx; background: linear-gradient(145deg, rgba(255,247,226,0.045), rgba(255,255,255,0.01)); }
.quote-mark { position: absolute; top: 8rpx; left: 18rpx; color: rgba(184,150,87,0.42); font-family: Georgia, serif; font-size: 64rpx; }
.question-input { width: 100%; height: 218rpx; box-sizing: border-box; padding: 26rpx 8rpx 12rpx; color: var(--paper); font-size: 30rpx; line-height: 1.68; }
.placeholder { color: #6e665a; }
.count { color: var(--muted); font-family: Georgia, serif; font-size: 19rpx; text-align: right; }
.decision { display: flex; margin-top: 32rpx; padding: 26rpx; border: 1rpx solid rgba(184,150,87,0.42); background: rgba(184,150,87,0.06); }
.decision.blocked { border-color: rgba(168,91,79,0.72); }
.decision-symbol { display: flex; align-items: center; justify-content: center; flex: 0 0 50rpx; height: 50rpx; border: 1rpx solid currentColor; border-radius: 50%; color: var(--gold); font-size: 24rpx; }
.blocked .decision-symbol { color: #d9978c; }
.decision-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.decision-title { font-size: 28rpx; }
.decision-message { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.58; }
.suggestion { margin-top: 16rpx; padding-left: 18rpx; border-left: 2rpx solid var(--gold); color: var(--paper-dim); font-size: 26rpx; line-height: 1.6; }
.rewrite { min-height: 72rpx; margin-top: 18rpx; padding: 9rpx 22rpx; font-size: 23rpx; line-height: 52rpx; }
.submit { margin-top: 44rpx; }
.submit text { float: right; font-size: 36rpx; }
.privacy-note { margin-top: 24rpx; padding: 22rpx 24rpx; border-top: 1rpx solid rgba(184,150,87,.18); color: var(--muted); text-align: center; }
.privacy-title { color: var(--paper-dim); font-size: 21rpx; }
.privacy-title text { margin-right: 7rpx; color: var(--gold); }
.privacy-copy { margin-top: 8rpx; font-size: 18rpx; line-height: 1.55; }
