<view class="page question-page">
  <view class="flow-head enter-up">
    <view class="flow-step">01</view>
    <view class="flow-line"><view class="flow-line-active"></view></view>
    <view class="flow-total">03</view>
  </view>

  <view class="enter-up delay-1">
    <view class="eyebrow">CHOOSE YOUR WAY IN</view>
    <view class="title"><text>把此刻，</text><text class="title-line">放到镜前。</text></view>
    <view class="subtitle">不必先想好问题，也可以从生活的三个方向开始。</view>
  </view>

  <view class="form-section enter-up delay-2">
    <view class="field-head"><text>选择解读方式</text><text class="field-index">I</text></view>
    <view class="focus-switch" aria-role="radiogroup" aria-label="选择解读方式">
      <view wx:for="{{focusModes}}" wx:key="value" class="focus-option {{selectedFocusMode === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectFocusMode" aria-role="radio" aria-checked="{{selectedFocusMode === item.value}}">
        <view class="focus-status">{{selectedFocusMode === item.value ? '◆' : '◇'}}</view>
        <view class="focus-copy">
          <view class="focus-name">{{item.label}}</view>
          <view class="focus-desc">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section spread-section enter-up delay-2">
    <view class="field-head"><text>选择牌阵</text><text class="field-index">II</text></view>
    <view class="spread-grid">
      <view wx:for="{{spreads}}" wx:key="value" class="spread-option {{selectedSpread === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectSpread">
        <view class="spread-visual {{item.value}}">
          <view class="spread-mini"></view>
          <view wx:if="{{item.value === 'three'}}" class="spread-mini"></view>
          <view wx:if="{{item.value === 'three'}}" class="spread-mini"></view>
        </view>
        <view class="spread-check">{{selectedSpread === item.value ? '◆' : '◇'}}</view>
        <view class="spread-name">{{item.label}}</view>
        <view class="spread-desc">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedFocusMode === 'question'}}" class="form-section question-section mode-reveal">
    <view class="field-head"><text>写下你的困扰</text><text class="field-index">III</text></view>
    <view class="question-shell">
      <view class="quote-mark">“</view>
      <textarea class="question-input" value="{{question}}" maxlength="200" placeholder="例如：我该如何理解最近和朋友之间的疏远？" placeholder-class="placeholder" bindinput="updateQuestion" />
      <view class="count">{{count}} / 200</view>
    </view>
  </view>

  <view wx:if="{{decision}}" class="decision {{isBlocked ? 'blocked' : ''}}">
    <view class="decision-symbol">{{isBlocked ? '!' : '↻'}}</view>
    <view class="decision-body">
      <view class="decision-title">{{isBlocked ? '这类问题不适合交给牌面' : '可以换一个更可回答的问法'}}</view>
      <view class="decision-message">{{decision.message}}</view>
      <view wx:if="{{decision.suggestedQuestion}}" class="suggestion">{{decision.suggestedQuestion}}</view>
      <button wx:if="{{canAdoptRewrite}}" class="secondary rewrite" bindtap="adoptRewrite">采用这个问法</button>
    </view>
  </view>

  <button wx:if="{{!isBlocked}}" class="primary submit" bindtap="submitReading">进入{{selectedSpread === 'three' ? '三牌仪式' : '单牌仪式'}} <text>→</text></button>
  <view wx:if="{{selectedFocusMode === 'question'}}" class="privacy-note mode-reveal">
    <view class="privacy-title"><text>◇</text> AI 只处理这一次问题</view>
    <view class="privacy-copy">请勿填写姓名、电话或地址 · 本机自动保留最近 30 条解读</view>
  </view>
</view>
