<view class="page">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="eyebrow">INTERPRETATION</view>
    <view class="title">正在整理牌面</view>
    <view class="subtitle">本地模拟 Provider 正在生成结构化结果。</view>
  </view>

  <view wx:elif="{{missing}}" class="panel">
    <view class="title small">没有找到这次解读</view>
    <view class="subtitle">它可能没有保存，或已经被删除。</view>
    <button class="primary" bindtap="returnHome">返回首页</button>
  </view>

  <block wx:elif="{{view}}">
    <view class="eyebrow">{{view.topic}} · {{view.date}}</view>
    <view class="title">{{view.title}}</view>
    <view class="source {{view.isFallback ? 'fallback' : ''}}">{{view.sourceLabel}}</view>
    <view wx:if="{{view.isFallback}}" class="reason">原因：{{view.reasonCode}}</view>

    <view class="result-spread {{view.isThree ? 'three' : 'single'}}">
      <view wx:for="{{view.cards}}" wx:key="cardId" class="visual-card">
        <view wx:if="{{view.isThree}}" class="position-label">{{item.positionLabel}}</view>
        <image class="card-image {{item.orientation === 'reversed' ? 'reversed' : ''}}" src="{{item.imagePath}}" mode="aspectFill" />
        <view class="visual-name">{{item.name}} · {{item.orientationLabel}}</view>
      </view>
    </view>

    <view wx:if="{{view.question}}" class="panel question-panel">
      <button class="text-button" bindtap="toggleQuestion">{{questionExpanded ? '收起原问题' : '查看原问题'}}</button>
      <view wx:if="{{questionExpanded}}" class="question-text">{{view.question}}</view>
    </view>

    <view class="content-block">
      <view class="content-label">整体观察</view>
      <view class="content-text">{{view.content.summary}}</view>
    </view>

    <view class="content-block synthesis">
      <view class="content-label">{{view.isThree ? '三牌联系' : '综合提示'}}</view>
      <view class="content-text">{{view.content.synthesis}}</view>
    </view>

    <view wx:for="{{view.cards}}" wx:key="cardId" class="card-reading">
      <view class="card-reading-head">
        <view>
          <view class="position-label">{{item.positionLabel}}</view>
          <view class="card-reading-title">{{item.roman}} · {{item.name}} · {{item.orientationLabel}}</view>
        </view>
        <view class="keywords">
          <text wx:for="{{item.keywords}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
      </view>

      <view class="content-block compact">
        <view class="content-label">{{item.orientationLabel}}解读</view>
        <view class="content-text">{{item.basis}}</view>
        <view class="content-text secondary-text">{{item.contextualMeaning}}</view>
      </view>

      <view class="dimension-grid">
        <view class="dimension-item">
          <view class="dimension-title">爱情</view>
          <view class="dimension-text">{{item.loveInsight}}</view>
        </view>
        <view class="dimension-item">
          <view class="dimension-title">财运</view>
          <view class="dimension-text">{{item.wealthInsight}}</view>
        </view>
        <view class="dimension-item">
          <view class="dimension-title">事业</view>
          <view class="dimension-text">{{item.careerInsight}}</view>
        </view>
        <view class="dimension-item">
          <view class="dimension-title">自我成长</view>
          <view class="dimension-text">{{item.selfGrowthInsight}}</view>
        </view>
      </view>
    </view>

    <view class="content-block emphasis">
      <view class="content-label">留给你的问题</view>
      <view class="reflection">{{view.content.reflectionQuestion}}</view>
    </view>

    <view class="content-block">
      <view class="content-label">一个小行动</view>
      <view class="content-text">{{view.content.microAction}}</view>
      <button class="text-button" bindtap="copyAction">复制行动</button>
    </view>

    <view class="disclaimer">{{view.content.disclaimer}}</view>

    <button wx:if="{{!view.isDaily && !view.saved}}" class="primary" bindtap="saveToHistory">保存到本地历史</button>
    <button class="secondary" bindtap="finish">{{!view.isDaily && !view.saved ? '不保存并结束' : '完成'}}</button>
  </block>
</view>
