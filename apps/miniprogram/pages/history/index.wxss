.history-page { padding-top: 44rpx; }
.history-page .title { font-size: 64rpx; }
.history-list { position: relative; margin-top: 52rpx; }
.timeline-line { position: absolute; top: 20rpx; bottom: 20rpx; left: 13rpx; width: 1rpx; background: linear-gradient(180deg, rgba(184,150,87,.5), rgba(184,150,87,.08)); }
.history-item { position: relative; display: flex; align-items: center; min-height: 226rpx; margin-left: 42rpx; padding: 25rpx 20rpx 25rpx 0; border-bottom: 1rpx solid rgba(184,150,87,.2); }
.timeline-dot { position: absolute; left: -41rpx; color: var(--gold); font-size: 18rpx; }
.history-image { flex: 0 0 98rpx; width: 98rpx; height: 147rpx; border: 1rpx solid rgba(184,150,87,.55); border-radius: 4rpx; box-shadow: 0 12rpx 28rpx rgba(0,0,0,.42); }
.history-image.reversed { transform: rotate(180deg); }
.history-main { flex: 1; min-width: 0; margin-left: 24rpx; }
.meta { color: var(--muted); font-size: 18rpx; letter-spacing: 1rpx; }
.kind { margin-top: 9rpx; color: var(--gold); font-size: 21rpx; }
.card-title { margin-top: 7rpx; overflow: hidden; color: var(--paper); font-size: 29rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.open-copy { margin-top: 16rpx; color: var(--paper-dim); font-size: 20rpx; }
.open-copy text { margin-left: 8rpx; color: var(--gold); }
.delete { align-self: flex-start; width: 50rpx; height: 50rpx; padding: 0; border: 1rpx solid rgba(168,91,79,.38); background: transparent; color: #a86f66; font-family: Georgia, serif; font-size: 28rpx; line-height: 46rpx; }
.empty-panel { margin-top: 58rpx; padding: 52rpx 34rpx; border: 1rpx solid rgba(184,150,87,.3); background: radial-gradient(circle at 50% 20%, rgba(184,150,87,.12), transparent 42%); text-align: center; }
.empty-seal { width: 170rpx; height: 170rpx; border: 1rpx solid rgba(184,150,87,.4); border-radius: 50%; opacity: .82; }
.empty-title { margin-top: 28rpx; font-size: 35rpx; }
.empty-panel .muted { margin-top: 15rpx; }
