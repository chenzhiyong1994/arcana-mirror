.home-page { padding-top: 28rpx; }
.brand { display: flex; align-items: center; min-height: 92rpx; }
.brand-seal { width: 82rpx; height: 82rpx; border: 1rpx solid rgba(184, 150, 87, 0.48); border-radius: 50%; box-shadow: 0 0 32rpx rgba(184, 150, 87, 0.12); }
.brand-copy { margin-left: 18rpx; }
.brand-cn { font-size: 29rpx; letter-spacing: 5rpx; }
.brand-en { margin-top: 7rpx; color: var(--gold); font-family: Georgia, serif; font-size: 15rpx; letter-spacing: 5rpx; }
.brand-mark { margin-left: auto; color: var(--gold); font-size: 24rpx; }
.hero { margin-top: 68rpx; }
.hero .title { display: flex; flex-direction: column; margin-top: 22rpx; font-size: 68rpx; }
.title-light { color: var(--paper-dim); }
.hero .subtitle { max-width: 610rpx; margin-top: 22rpx; }
.daily-stage { position: relative; display: flex; align-items: center; min-height: 430rpx; margin-top: 54rpx; padding: 36rpx 28rpx; overflow: hidden; border: 1rpx solid rgba(184, 150, 87, 0.34); border-radius: 8rpx; background: linear-gradient(125deg, rgba(29, 23, 16, 0.98), rgba(12, 10, 8, 0.94)); box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.35); }
.daily-stage::before, .daily-stage::after { position: absolute; width: 34rpx; height: 34rpx; border-color: rgba(224, 191, 121, 0.55); content: ""; }
.daily-stage::before { top: 15rpx; left: 15rpx; border-top: 1rpx solid; border-left: 1rpx solid; }
.daily-stage::after { right: 15rpx; bottom: 15rpx; border-right: 1rpx solid; border-bottom: 1rpx solid; }
.stage-halo { position: absolute; top: 50%; left: 16%; width: 300rpx; height: 300rpx; border: 1rpx solid rgba(184, 150, 87, 0.12); border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 90rpx rgba(184, 150, 87, 0.11), inset 0 0 80rpx rgba(184, 150, 87, 0.05); }
.mini-card { position: relative; z-index: 1; flex: 0 0 214rpx; height: 322rpx; overflow: hidden; border: 2rpx solid rgba(224, 191, 121, 0.62); border-radius: 7rpx; background: #0d0b08; box-shadow: 0 20rpx 46rpx rgba(0, 0, 0, 0.58), 0 0 26rpx rgba(184, 150, 87, 0.12); transform: rotate(-3deg); }
.mini-card-image { width: 100%; height: 100%; }
.mini-card-shine { position: absolute; top: -20%; left: -40%; width: 34%; height: 140%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent); animation: gold-sheen 5.6s ease-in-out 1.2s infinite; }
.daily-copy { position: relative; z-index: 2; flex: 1; min-width: 0; margin-left: 34rpx; }
.daily-title { margin-top: 14rpx; font-size: 36rpx; line-height: 1.35; }
.daily-note { margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.daily-action { min-height: 78rpx; margin-top: 25rpx; padding: 12rpx 22rpx; font-size: 24rpx; line-height: 52rpx; }
.choice-head { margin-top: 68rpx; }
.reading-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 25rpx; }
.reading-card { position: relative; min-height: 354rpx; padding: 26rpx 24rpx; overflow: hidden; border: 1rpx solid rgba(184, 150, 87, 0.28); border-radius: 7rpx; background: rgba(244, 234, 215, 0.025); transition: transform 180ms ease, border-color 180ms ease; }
.reading-card:active { border-color: var(--gold); transform: translateY(3rpx) scale(0.985); }
.reading-card.three { background: linear-gradient(145deg, rgba(184, 150, 87, 0.12), rgba(244, 234, 215, 0.018)); }
.reading-index { position: absolute; top: 22rpx; right: 22rpx; color: rgba(184, 150, 87, 0.38); font-family: Georgia, serif; font-size: 42rpx; }
.reading-glyph { display: flex; align-items: flex-end; height: 84rpx; }
.glyph-card { width: 39rpx; height: 61rpx; border: 1rpx solid var(--gold); border-radius: 3rpx; box-shadow: inset 0 0 0 4rpx #12100c, inset 0 0 0 5rpx rgba(184,150,87,0.35); transform: rotate(-6deg); }
.triple .glyph-card { margin-right: -13rpx; transform: rotate(-10deg); }
.triple .glyph-card:nth-child(2) { z-index: 2; transform: translateY(-7rpx); }
.triple .glyph-card:nth-child(3) { transform: rotate(10deg); }
.reading-name { margin-top: 16rpx; font-size: 34rpx; }
.reading-desc { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.reading-desc-line { display: block; }
.reading-enter { position: absolute; right: 24rpx; bottom: 24rpx; left: 24rpx; color: var(--gold-bright); font-size: 23rpx; }
.reading-enter text { float: right; }
.collection-entry { display: flex; align-items: center; margin-top: 64rpx; padding: 30rpx 0; border-top: 1rpx solid rgba(184, 150, 87, 0.25); border-bottom: 1rpx solid rgba(184, 150, 87, 0.25); }
.collection-orbit { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border: 1rpx solid var(--gold); border-radius: 50%; background: radial-gradient(circle, rgba(184,150,87,0.14), transparent 66%); color: var(--gold-bright); font-family: Georgia, serif; font-size: 23rpx; box-shadow: inset 0 0 0 8rpx #0c0a08, inset 0 0 0 9rpx rgba(184,150,87,0.28); }
.collection-info { flex: 1; margin-left: 24rpx; }
.collection-copy { margin-top: 7rpx; font-size: 31rpx; }
.collection-note { margin-top: 7rpx; color: var(--muted); font-size: 21rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 68rpx; }
.section-title.small { font-size: 34rpx; }
.section-head .text-button { margin: 0; }
.history-list { margin-top: 20rpx; border-top: 1rpx solid rgba(184, 150, 87, 0.2); }
.history-row { display: flex; align-items: center; min-height: 126rpx; padding: 20rpx 0; border-bottom: 1rpx solid rgba(184, 150, 87, 0.17); }
.history-thumb { flex: 0 0 58rpx; width: 58rpx; height: 88rpx; overflow: hidden; border: 1rpx solid rgba(184,150,87,0.52); border-radius: 3rpx; }
.history-copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.history-type { color: var(--muted); font-size: 20rpx; }
.history-title { margin-top: 8rpx; overflow: hidden; font-size: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.arrow { color: var(--gold); font-family: Georgia, serif; font-size: 42rpx; }
.empty { margin-top: 22rpx; padding: 38rpx 24rpx; border: 1rpx dashed rgba(184,150,87,0.22); color: var(--paper-dim); font-size: 28rpx; text-align: center; }
.empty-star { margin-bottom: 14rpx; color: var(--gold); }
.empty-copy { margin-top: 9rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.settings-link { margin: 50rpx auto 0; color: var(--muted); font-size: 22rpx; text-align: center; }
