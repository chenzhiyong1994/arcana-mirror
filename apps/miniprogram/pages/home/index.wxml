<view class="page home-page">
  <view class="brand enter-up">
    <image class="brand-seal" src="{{logoPath}}" mode="aspectFill" />
    <view class="brand-copy">
      <view class="brand-cn">心镜拾光</view>
      <view class="brand-en">MIRRORLIGHT</view>
    </view>
    <view class="brand-mark">✦</view>
  </view>

  <view class="hero enter-up delay-1">
    <view class="eyebrow">A QUIET RITUAL FOR CLARITY</view>
    <view class="title"><text class="title-light">翻开牌面，</text><text>照见自己。</text></view>
    <view class="subtitle">用一场短暂仪式，让混乱慢慢显出轮廓。</view>
  </view>

  <view class="daily-stage enter-up delay-2">
    <view class="stage-halo"></view>
    <view class="mini-card">
      <tarot-card-face
        wx:if="{{today}}"
        class="mini-card-face"
        image-path="{{today.imagePath}}"
        arcana="{{today.arcana}}"
        top-mark="{{today.roman}}"
        name="{{today.name}}"
        english-name="{{today.englishName}}"
        orientation="{{today.reversed ? 'reversed' : 'upright'}}"
        variant="compact"
      />
      <image wx:else class="mini-card-image" src="{{cardBack}}" mode="aspectFill" />
      <view class="mini-card-shine"></view>
    </view>
    <view class="daily-copy">
      <view class="section-kicker">TODAY'S MIRROR</view>
      <view class="daily-title">{{today ? today.title : '今日牌仍在沉睡'}}</view>
      <view class="daily-note">{{today ? '随时回来重读。' : '留下一句今天值得记住的话。'}}</view>
      <button class="primary daily-action" bindtap="startDaily">{{today ? '重新进入今日解读' : '抽取每日一牌'}}</button>
    </view>
  </view>

  <view class="choice-head enter-up delay-3">
    <view>
      <view class="section-kicker">CHOOSE A READING</view>
      <view class="section-title">此刻，你想看清什么？</view>
    </view>
  </view>

  <view class="reading-actions enter-up delay-3">
    <view class="reading-card single" bindtap="startSingleQuestion">
      <view class="reading-glyph"><view class="glyph-card"></view></view>
      <view class="reading-index">01</view>
      <view class="reading-name">一张牌</view>
      <view class="reading-desc">聚焦一个核心提示</view>
      <view class="reading-enter">开始解读 <text>→</text></view>
    </view>
    <view class="reading-card three" bindtap="startThreeQuestion">
      <view class="reading-glyph triple"><view class="glyph-card"></view><view class="glyph-card"></view><view class="glyph-card"></view></view>
      <view class="reading-index">03</view>
      <view class="reading-name">三张牌</view>
      <view class="reading-desc">现状 · 影响 · 行动</view>
      <view class="reading-enter">进入牌阵 <text>→</text></view>
    </view>
  </view>

  <view class="collection-entry" bindtap="openCollection">
    <view class="collection-orbit"><text>{{collectionProgress}}</text></view>
    <view class="collection-info">
      <view class="section-kicker">MIRROR COLLECTION</view>
      <view class="collection-copy">我的七十八张心镜图鉴</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-kicker">RECENT MIRRORS</view>
      <view class="section-title small">最近照见</view>
    </view>
    <view class="section-rule"></view>
    <button class="text-button history-all" bindtap="openHistory">全部记录</button>
  </view>

  <view wx:if="{{recent.length}}" class="history-list">
    <view wx:for="{{recent}}" wx:key="id" class="history-row" data-id="{{item.id}}" bindtap="openReading">
      <view class="history-thumb">
        <tarot-card-face
          image-path="{{item.imagePath}}"
          arcana="{{item.arcana}}"
          top-mark="{{item.roman}}"
          name="{{item.name}}"
          english-name="{{item.englishName}}"
          orientation="{{item.reversed ? 'reversed' : 'upright'}}"
          variant="micro"
        />
      </view>
      <view class="history-copy">
        <view class="history-type">{{item.typeLabel}} · {{item.date}}</view>
        <view class="history-title">{{item.title}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
  <view wx:else class="empty">
    <view class="empty-star">✦</view>
    <view>尚无记录</view>
    <view class="empty-copy">完成一次解读后，会自动出现在这里。</view>
  </view>

  <view class="home-share">
    <button class="home-share-button" bindtap="generateAppPoster" loading="{{generatingPoster}}" disabled="{{generatingPoster}}">
      <text class="share-symbol">✦</text>
      <text>分享心镜拾光</text>
    </button>
  </view>

  <share-poster-preview visible="{{posterVisible}}" poster-path="{{posterPath}}" bind:close="closePoster" />
  <canvas type="2d" id="sharePoster" class="share-poster-canvas"></canvas>
</view>
