.ritual-page { text-align: center; }
.title.small { font-size: 38rpx; }
.card-spread { display: flex; align-items: flex-start; justify-content: center; margin: 46rpx auto 30rpx; }
.card-spread.single .ritual-card { width: 430rpx; }
.card-spread.three { gap: 14rpx; }
.card-spread.three .ritual-card { width: 210rpx; }
.position-label { min-height: 34rpx; margin-bottom: 14rpx; color: var(--gold); font-size: 22rpx; }
.image-shell { position: relative; width: 100%; overflow: hidden; border: 2rpx solid rgba(168, 137, 80, 0.7); background: #171511; box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.38); aspect-ratio: 2 / 3; }
.card-image { width: 100%; height: 100%; }
.card-image.reversed { transform: rotate(180deg); }
.tap-hint { position: absolute; right: 0; bottom: 24rpx; left: 0; color: var(--paper-dim); font-size: 20rpx; letter-spacing: 3rpx; text-shadow: 0 2rpx 8rpx #000; }
.revealed-meta { margin-top: 14rpx; color: var(--paper); font-size: 24rpx; line-height: 1.35; }
.card-spread.single .revealed-meta { font-size: 32rpx; }
.orientation { margin-top: 6rpx; color: var(--gold); font-size: 21rpx; }
.progress { color: var(--muted); font-size: 23rpx; }
