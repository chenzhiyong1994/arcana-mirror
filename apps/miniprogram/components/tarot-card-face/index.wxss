:host {
  display: block;
  width: 100%;
  height: 100%;
}

.tarot-face {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #090806;
  transform: rotate(0deg);
  transform-origin: center;
  transition: transform 240ms ease;
}

.tarot-face.is-reversed {
  transform: rotate(180deg);
}

.face-art {
  display: block;
  width: 100%;
  height: 100%;
}

.frame-overlay {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.frame-rank,
.frame-title {
  position: absolute;
  z-index: 3;
  pointer-events: none;
}

.frame-rank {
  top: 3.7%;
  left: 37.5%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 25%;
  height: 4.8%;
  color: #e2bd72;
  overflow: hidden;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 15rpx;
  letter-spacing: 1rpx;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 4rpx #000;
  white-space: nowrap;
}

.frame-title {
  right: 24.5%;
  bottom: 4.15%;
  left: 24.5%;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  height: 8.7%;
  min-width: 0;
  overflow: hidden;
  text-align: center;
  text-shadow: 0 1rpx 4rpx #000;
}

.frame-name {
  width: 100%;
  overflow: hidden;
  color: #e5c47f;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.frame-english {
  margin-top: 3rpx;
  width: 100%;
  overflow: hidden;
  color: #d8b56f;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 9rpx;
  letter-spacing: .5rpx;
  line-height: 1;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.tarot-face--micro .frame-rank { font-size: 4rpx; letter-spacing: 0; }
.tarot-face--micro .frame-name { font-size: 5rpx; letter-spacing: 0; }
.tarot-face--micro .frame-english { display: none; }

.tarot-face--compact .frame-rank { font-size: 10rpx; }
.tarot-face--compact .frame-name { font-size: 13rpx; letter-spacing: 1rpx; }
.tarot-face--compact .frame-english { font-size: 6rpx; }

.tarot-face--hero .frame-rank { font-size: 20rpx; letter-spacing: 2rpx; }
.tarot-face--hero .frame-name { font-size: 24rpx; letter-spacing: 3rpx; }
.tarot-face--hero .frame-english { margin-top: 4rpx; font-size: 12rpx; letter-spacing: 1rpx; }

.tarot-face--preview .frame-rank { font-size: 28rpx; letter-spacing: 2rpx; }
.tarot-face--preview .frame-name { font-size: 32rpx; letter-spacing: 4rpx; }
.tarot-face--preview .frame-english { margin-top: 6rpx; font-size: 17rpx; letter-spacing: 1rpx; }
