<view
  class="tarot-face tarot-face--{{arcana}} tarot-face--{{variant}} {{orientation === 'reversed' ? 'is-reversed' : ''}}"
  aria-role="img"
  aria-label="{{name}} · {{orientation === 'reversed' ? '逆位' : '正位'}}"
>
  <image class="face-art" src="{{imagePath}}" mode="aspectFill" />

  <block wx:if="{{arcana === 'minor'}}">
    <image
      class="frame-overlay"
      src="/assets/cards/front-frame-overlay.png"
      mode="scaleToFill"
    />
    <text class="frame-rank">{{roman}}</text>
    <view class="frame-title">
      <view class="frame-name">{{name}}</view>
      <view class="frame-english">{{englishName}}</view>
    </view>
  </block>
</view>
