<!-- Card experience subpackage page. -->
<view class="page history-page">
  <view class="enter-up">
    <view class="eyebrow">MIRRORS KEPT LOCALLY</view>
    <view class="title">照见记录</view>
    <view class="subtitle">自动保留最近 30 条 · 仅在当前设备可见</view>
  </view>

  <view wx:if="{{items.length}}" class="history-list enter-up delay-1">
    <view wx:for="{{items}}" wx:key="id" class="history-item" data-id="{{item.id}}" bindtap="openReading">
      <view class="history-image">
        <tarot-card-face
          image-path="{{item.imagePath}}"
          arcana="{{item.arcana}}"
          top-mark="{{item.roman}}"
          name="{{item.name}}"
          english-name="{{item.englishName}}"
          orientation="{{item.reversed ? 'reversed' : 'upright'}}"
          variant="micro"
        />
      </view>
      <view class="history-main">
        <view class="history-meta"><text class="kind">{{item.kind}}</text><text>{{item.date}}</text></view>
        <view class="card-title">{{item.card}}</view>
        <view class="history-foot">
          <text class="source">{{item.source}}</text>
          <view class="history-actions">
            <button class="history-action reread" data-id="{{item.id}}" catchtap="openReading" aria-label="重读这条记录">重读</button>
            <button class="history-action delete" data-id="{{item.id}}" catchtap="deleteReading" aria-label="删除这条记录">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-panel enter-up delay-1">
    <image class="empty-seal" src="/assets/branding/arcana-mirror-logo.jpg" mode="aspectFill" />
    <view class="empty-title">镜面还没有留下痕迹</view>
    <view class="muted">完成一次解读后，会自动保留在这里。</view>
    <button class="primary" bindtap="startReading">开始一次解读</button>
  </view>
</view>
